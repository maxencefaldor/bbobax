# What this repository's own toolchain produces. What your editor or your machine
# produces belongs in a global ignore (`git config --global core.excludesFile`) --
# except the two below, which reach shared clones too often to leave to personal
# configuration.

# Python
__pycache__/
*.py[oc]

# Packaging and environments
build/
dist/
wheels/
*.egg-info
.venv

# Tool caches
.pytest_cache
.ruff_cache
.coverage

# Editor and OS droppings
.vscode
.DS_Store

# Secrets
.env

# Documentation, built by mkdocs
site/
.cache/

# Notebooks
.ipynb_checkpoints
